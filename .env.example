FLOWPAY_PAYMENTS_DSN=postgres://flowpay:flowpay@127.0.0.1:5432/flowpay?sslmode=disable
FLOWPAY_PAYMENTS_ADDR=:8081
# Si queda vacío se usa FLOWPAY_JWT_SECRET. En producción hace falta uno de los dos, mínimo 16 caracteres, igual al SSO.
FLOWPAY_PAYMENTS_JWT_SECRET=
FLOWPAY_PAYMENTS_PUBLIC_BASE_URL=
FLOWPAY_PAYMENTS_FRONTEND_BASE_URL=http://localhost:5173
FLOWPAY_PAYMENTS_TRANSBANK_ENV=integration
# Misma clave que flowpay-backend (mín. 32). En producción el proceso no arranca si falta.
FLOWPAY_PAYMENT_CREDENTIALS_KEY=
